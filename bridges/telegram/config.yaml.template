homeserver:
  address: http://synapse:8008
  domain: ${SYNAPSE_SERVER_NAME}
  # Where the bridge should POST connection-state changes.
  # In dev on macOS, use: http://host.docker.internal:4000/bridge/status
  status_endpoint: ${MULTICHAT_BRIDGE_STATUS_ENDPOINT}

appservice:
  address: http://telegram:29318
  hostname: 0.0.0.0
  port: 29318
  as_token: "${TELEGRAM_AS_TOKEN}"
  hs_token: "${TELEGRAM_HS_TOKEN}"
  database: postgres://${TELEGRAM_POSTGRES_USER}:${TELEGRAM_POSTGRES_PASSWORD}@postgres_telegram:5432/${TELEGRAM_POSTGRES_DB}?sslmode=disable
  # Provisioning API — backend talks to this endpoint on behalf of users.
  # Without an explicit shared_secret, mautrix-python's "generate" default
  # rotates the secret on every restart (the entrypoint overwrites this file
  # from the template each boot), which breaks the multichat backend.
  provisioning:
    enabled: true
    prefix: /_matrix/provision
    shared_secret: "${TELEGRAM_PROVISIONING_TOKEN}"

telegram:
  api_id: ${TELEGRAM_API_ID}
  api_hash: "${TELEGRAM_API_HASH}"

bridge:
  username_template: "telegram_{userid}"
  displayname_template: "{displayname}"
  command_prefix: "!tg"
  permissions:
    "*": puppeting
    "@admin:${SYNAPSE_SERVER_NAME}": admin
  initial_sync_limit: 1000
  sync_direct_chats: true
  sync_dialog_limit: 1000
  login_shared_secret_map:
    ${SYNAPSE_SERVER_NAME}: "as_token:${TELEGRAM_AS_TOKEN}"
  private_chat_portal_meta: true
  initial_power_level_overrides:
    user:
      users_default: 0
      events_default: 0
      invite: 0
    group:
      users_default: 0
      events_default: 0
      invite: 0
  # Portal rooms are intentionally unencrypted during the beta simplification period.
  encryption:
    allow: false
    default: false
    require: false
    appservice: false
  backfill:
    enable: true
    normal_groups: true
    unread_hours_threshold: 720
    forward_limits:
      initial:
        user: 100
        normal_group: 100
        supergroup: 100
        channel: 100
      sync:
        user: 100
        normal_group: 100
        supergroup: 100
        channel: 100
    forward_timeout: 3000
    incremental:
      messages_per_batch: 100
      post_batch_delay: 20
      max_batches:
        user: -1
        normal_group: -1
        supergroup: -1
        channel: -1
